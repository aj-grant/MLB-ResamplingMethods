pvals = sapply(1:M, function(i){
X = data.frame("ID" = seq(1, n),
"Grp" = c(rep(0, n1), rep(1, n2)))
E = mv_rnorm(n, c(0, 0, 0), matrix(c(1, rho, rho, rho, 1, rho, rho, rho, 1), nrow = 3))
mu = c(rep(0, n1), rep(0.5, n2))
Y = mu + E
dat = data.frame("ID" = X$ID, "Y" = Y, "Grp" = X$Grp)
names(dat) = c("ID", "t0", "t1", "t2", "Grp")
dat = pivot_longer(dat, cols = c("t0", "t1", "t2"), values_to = "Y", names_to = "Time")
#Between factors:
#test = aov(Y~Grp+Time+Error(ID/(Grp+Time+Grp:Time)), data = dat)
#summary(test)[[5]][[1]][5][1, 1]
test = lm(Y ~ Grp + Time + Grp*Time, data = dat)
summary(test)$coef[2, 4]
})
sum(pvals<0.05/7)/M
